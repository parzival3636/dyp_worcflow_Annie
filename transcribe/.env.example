APP_ENV=dev
APP_BASE_URL=https://example.ngrok-free.app
DATABASE_URL=sqlite:///./transcribe.db
DEFAULT_TIMEZONE=Asia/Kolkata

FIREFLIES_API_KEY=dummy_fireflies_key
FIREFLIES_API_URL=https://api.fireflies.ai/graphql
FIREFLIES_WEBHOOK_SECRET=dummy_webhook_secret
FIREFLIES_BOT_NAME=Pilot Notetaker

LLM_PROVIDER=anthropic
LLM_API_KEY=dummy_llm_key
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TEMPERATURE=0

TELEGRAM_BOT_TOKEN=dummy_telegram_token
TELEGRAM_WEBHOOK_SECRET=dummy_telegram_secret

MEETING_DEDUP_WINDOW_HOURS=6
MEETING_EXPIRE_HOURS=6
POLL_INTERVAL_SECONDS=60
REMINDER_AFTER_HOURS=24
MAX_REMINDERS=2
MIN_TRANSCRIPT_WORDS=20
CONFIDENCE_THRESHOLD=0.5
